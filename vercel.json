{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cabeca": false
    }
  },
  "crons": [
    {
      "path": "/jobs/close-cash",
      "schedule": "00 01 * * *"
    }
  ]
}
